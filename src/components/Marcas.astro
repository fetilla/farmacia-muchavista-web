---
/**
 * Marcas autogeneradas desde src/config/marcas.yaml.
 * Las fotos se buscan en src/assets/marcas/; si no hay foto, se muestran las iniciales.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { getMarcas } from '../lib/config';

const { categorias: oficiales, marcas } = await getMarcas();
/** Marcas visibles antes de pulsar "Ver todas las marcas" (en cualquier pantalla y filtro) */
const VISIBLES = 8;
// Logos y fotos: los de mapa de bits se optimizan con <Image>; los SVG se sirven tal cual
const raster = import.meta.glob<{ default: ImageMetadata }>('../assets/marcas/*.{png,jpg,jpeg,webp,avif}', {
	eager: true,
});
const vectores = import.meta.glob<string>('../assets/marcas/*.svg', { eager: true, query: '?url', import: 'default' });
const fotoDe = (nombre?: string) => {
	if (!nombre) return undefined;
	const key = `../assets/marcas/${nombre.replace(/^marcas\//, '')}`;
	if (raster[key]) return { kind: 'raster' as const, src: raster[key].default };
	if (vectores[key]) return { kind: 'svg' as const, src: vectores[key] };
	throw new Error(`src/config/marcas.yaml: no se encuentra la foto "${nombre}" en src/assets/marcas/`);
};
const iniciales = (n: string) =>
	n
		.split(/[\s-]+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w[0]!.toUpperCase())
		.join('');
// Orden oficial del YAML; solo las categorías que tienen alguna marca
const categorias = oficiales.filter((c) => marcas.some((m) => m.categoria === c));
const slug = (s: string) =>
	s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-');
---

<div class="marcas" data-marcas data-visibles={VISIBLES}>
	{
		categorias.length > 1 && (
			<div class="marcas__filters" role="group" aria-label="Filtrar marcas por categoría">
				<button type="button" class="chip" aria-pressed="true" data-filter="todas">
					Todas
				</button>
				{categorias.map((c) => (
					<button type="button" class="chip" aria-pressed="false" data-filter={slug(c)}>
						{c}
					</button>
				))}
			</div>
		)
	}

	{
		marcas.length === 0 ? (
			<p class="marcas__empty">Pronto podrás ver aquí las marcas que tenemos en la farmacia.</p>
		) : (
			<ul class="marcas__grid" id="marcas-grid" role="list">
				{marcas.map((m) => {
					const foto = fotoDe(m.foto);
					return (
						<li class="marca reveal" data-categoria={slug(m.categoria)}>
							<div class:list={['marca__media', { 'has-logo': foto }]}>
								{foto?.kind === 'raster' ? (
									<Image src={foto.src} alt={`Logotipo de ${m.nombre}`} width={480} class="marca__img" />
								) : foto?.kind === 'svg' ? (
									<img src={foto.src} alt={`Logotipo de ${m.nombre}`} class="marca__img" loading="lazy" decoding="async" />
								) : (
									<span class="marca__initials" aria-hidden="true">
										{iniciales(m.nombre)}
									</span>
								)}
							</div>
							<div class="marca__body">
								<p class="marca__cat">{m.categoria}</p>
								<h3 class="marca__name">{m.nombre}</h3>
								<p class="marca__desc">{m.descripcion}</p>
							</div>
						</li>
					);
				})}
			</ul>
		)
	}
	{
		marcas.length > VISIBLES && (
			<button
				type="button"
				class="marcas__divider"
				data-more
				aria-expanded="false"
				aria-controls="marcas-grid"
				hidden
			>
				<span class="marcas__divider-label">
					<span data-more-label>Ver todas las marcas ({marcas.length})</span>
					<Icon name="caret-down" size={18} class="marcas__divider-icon" />
				</span>
			</button>
		)
	}
</div>

<style>
	.marcas {
		position: relative;
		display: grid;
		gap: var(--s-300);
	}

	.marcas__filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-75);
	}

	.chip {
		min-height: 44px;
		padding: var(--s-75) var(--s-200);
		border: 0;
		border-radius: 9999px;
		background: var(--card);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: var(--ink);
		font: inherit;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.14);
		transition:
			background-color 0.7s var(--ease),
			color 0.7s var(--ease),
			transform 0.7s var(--ease);
	}

	.chip:hover {
		transform: translateY(-2px);
	}

	.chip:active {
		transform: scale(0.98);
	}

	.chip[aria-pressed='true'] {
		background: var(--ink);
		color: var(--foam);
	}

	.marcas__grid {
		display: grid;
		gap: var(--s-200);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 640px) {
		.marcas__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.marcas__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.marca {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 24px;
		background: var(--card);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 16px 48px rgb(14 58 91 / 0.16);
	}

	.marca[hidden] {
		display: none;
	}

	/* Marcas que exceden el máximo visible hasta pulsar "Ver todas las marcas" */
	.marca.is-collapsed {
		display: none;
	}

	/* Separador horizontal pulsable: línea a todo el ancho con la etiqueta centrada */
	.marcas__divider {
		display: flex;
		align-items: center;
		gap: var(--s-200);
		width: 100%;
		min-height: 48px;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		cursor: pointer;
	}

	.marcas__divider[hidden] {
		display: none;
	}

	.marcas__divider::before,
	.marcas__divider::after {
		content: '';
		flex: 1;
		height: 2px;
		border-radius: 2px;
		background: rgb(251 253 255 / 0.75);
		transition: background-color 0.7s var(--ease);
	}

	.marcas__divider-label {
		display: inline-flex;
		align-items: center;
		gap: var(--s-75);
		min-height: 44px;
		padding: var(--s-75) var(--s-200);
		border-radius: 9999px;
		background: var(--card);
		color: var(--ink);
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 700;
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.18);
		transition:
			transform 0.7s var(--ease),
			background-color 0.7s var(--ease);
	}

	.marcas__divider:hover .marcas__divider-label {
		transform: translateY(-2px);
		background: #fff;
	}

	.marcas__divider:hover::before,
	.marcas__divider:hover::after {
		background: #fff;
	}

	.marcas__divider:active .marcas__divider-label {
		transform: scale(0.98);
	}

	.marcas__divider :global(.marcas__divider-icon) {
		transition: transform 0.7s var(--ease);
	}

	.marcas__divider[aria-expanded='true'] :global(.marcas__divider-icon) {
		transform: rotate(180deg);
	}

	.marca__media {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		background: #fff;
	}

	/* Logos: enteros y centrados sobre fondo blanco */
	.marca__media.has-logo {
		background: #fff;
		padding: var(--s-400) var(--s-500);
	}

	.marca__img {
		width: 100%;
		height: 100%;
		max-height: 96px;
		object-fit: contain;
	}

	.marca__initials {
		display: grid;
		place-items: center;
		width: 80px;
		height: 80px;
		border-radius: 9999px;
		background: var(--foam);
		color: var(--brand);
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-weight: 700;
		box-shadow: inset 0 0 0 2px var(--brand-soft);
	}

	.marca__body {
		display: grid;
		gap: var(--s-75);
		padding: var(--s-300);
	}

	.marca__cat {
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sea);
	}

	.marca__name {
		font-size: 1.25rem;
		line-height: 1.75rem;
	}

	.marca__desc {
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--ink-soft);
	}

	.marcas__empty {
		padding: var(--s-400);
		border-radius: 24px;
		background: var(--card);
	}
</style>

<script>
	const slugify = (s: string) =>
		s
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-');

	document.querySelectorAll<HTMLElement>('[data-marcas]').forEach((root) => {
		const max = Number(root.dataset.visibles) || 8;
		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
		const items = Array.from(root.querySelectorAll<HTMLElement>('[data-categoria]'));
		const more = root.querySelector<HTMLButtonElement>('[data-more]');
		const label = root.querySelector<HTMLElement>('[data-more-label]');
		let filter = 'todas';
		let expanded = false;

		function apply() {
			const matching = items.filter((it) => filter === 'todas' || it.dataset.categoria === filter);
			items.forEach((it) => {
				it.hidden = !matching.includes(it);
				it.classList.remove('is-collapsed');
			});
			if (!expanded) matching.slice(max).forEach((it) => it.classList.add('is-collapsed'));
			if (more && label) {
				more.hidden = matching.length <= max;
				more.setAttribute('aria-expanded', String(expanded));
				label.textContent = expanded ? 'Ver menos' : `Ver todas las marcas (${matching.length})`;
			}
		}

		function setFilter(value: string) {
			filter = value;
			expanded = false;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === value)));
			apply();
		}

		buttons.forEach((btn) => btn.addEventListener('click', () => setFilter(btn.dataset.filter || 'todas')));

		more?.addEventListener('click', () => {
			expanded = !expanded;
			apply();
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (expanded) {
				// El foco pasa a la primera marca que estaba oculta
				const first = items.filter((it) => !it.hidden)[max];
				if (first) {
					first.classList.add('is-visible');
					first.setAttribute('tabindex', '-1');
					first.focus({ preventScroll: true });
				}
			} else {
				root.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
			}
		});

		// Enlaces desde otras secciones con una categoría (p. ej. la noticia de Kiokids)
		document.querySelectorAll<HTMLAnchorElement>('[data-filtro-marca]').forEach((a) =>
			a.addEventListener('click', () => {
				const value = slugify(a.dataset.filtroMarca || '');
				if (buttons.some((b) => b.dataset.filter === value)) setFilter(value);
			}),
		);

		apply();
	});
</script>
