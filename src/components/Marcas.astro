---
/**
 * Marcas autogeneradas desde src/config/marcas.yaml.
 * Las fotos se buscan en src/assets/marcas/; si no hay foto, se muestran las iniciales.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getMarcas } from '../lib/config';

const marcas = await getMarcas();
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/marcas/*.{png,jpg,jpeg,webp,avif,svg}', {
	eager: true,
});
const fotoDe = (nombre?: string) => {
	if (!nombre) return undefined;
	const file = nombre.replace(/^marcas\//, '');
	return fotos[`../assets/marcas/${file}`]?.default;
};
const iniciales = (n: string) =>
	n
		.split(/[\s-]+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w[0]!.toUpperCase())
		.join('');
const categorias = [...new Set(marcas.map((m) => m.categoria))];
const slug = (s: string) =>
	s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-');
const showBadge = import.meta.env.DEV && marcas.some((m) => m.provisional);
---

<div class="marcas" data-marcas>
	{showBadge && <span class="provisional-badge">Marcas de ejemplo</span>}
	{
		categorias.length > 1 && (
			<div class="marcas__filters" role="group" aria-label="Filtrar marcas por categoría">
				<button type="button" class="chip" aria-pressed="true" data-filter="todas">
					Todas
				</button>
				{categorias.map((c) => (
					<button type="button" class="chip" aria-pressed="false" data-filter={slug(c)}>
						{c}
					</button>
				))}
			</div>
		)
	}

	{
		marcas.length === 0 ? (
			<p class="marcas__empty">Pronto podrás ver aquí las marcas que tenemos en la farmacia.</p>
		) : (
			<ul class="marcas__grid" role="list">
				{marcas.map((m) => {
					const foto = fotoDe(m.foto);
					return (
						<li class="marca reveal" data-categoria={slug(m.categoria)}>
							<div class="marca__media">
								{foto ? (
									<Image src={foto} alt={`Productos de ${m.nombre}`} width={480} class="marca__img" />
								) : (
									<span class="marca__initials" aria-hidden="true">
										{iniciales(m.nombre)}
									</span>
								)}
							</div>
							<div class="marca__body">
								<p class="marca__cat">{m.categoria}</p>
								<h3 class="marca__name">{m.nombre}</h3>
								<p class="marca__desc">{m.descripcion}</p>
							</div>
						</li>
					);
				})}
			</ul>
		)
	}
</div>

<style>
	.marcas {
		position: relative;
		display: grid;
		gap: var(--s-300);
	}

	.marcas__filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-75);
	}

	.chip {
		min-height: 44px;
		padding: var(--s-75) var(--s-200);
		border: 0;
		border-radius: 9999px;
		background: var(--card);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: var(--ink);
		font: inherit;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.14);
		transition:
			background-color 0.7s var(--ease),
			color 0.7s var(--ease),
			transform 0.7s var(--ease);
	}

	.chip:hover {
		transform: translateY(-2px);
	}

	.chip:active {
		transform: scale(0.98);
	}

	.chip[aria-pressed='true'] {
		background: var(--ink);
		color: var(--foam);
	}

	.marcas__grid {
		display: grid;
		gap: var(--s-200);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 640px) {
		.marcas__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.marcas__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.marca {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 24px;
		background: var(--card);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 16px 48px rgb(14 58 91 / 0.16);
	}

	.marca[hidden] {
		display: none;
	}

	.marca__media {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		background: var(--sand);
	}

	.marca__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.marca__initials {
		display: grid;
		place-items: center;
		width: 80px;
		height: 80px;
		border-radius: 9999px;
		background: var(--foam);
		color: var(--brand);
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-weight: 700;
		box-shadow: inset 0 0 0 2px var(--brand-soft);
	}

	.marca__body {
		display: grid;
		gap: var(--s-75);
		padding: var(--s-300);
	}

	.marca__cat {
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sea);
	}

	.marca__name {
		font-size: 1.25rem;
		line-height: 1.75rem;
	}

	.marca__desc {
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--ink-soft);
	}

	.marcas__empty {
		padding: var(--s-400);
		border-radius: 24px;
		background: var(--card);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-marcas]').forEach((root) => {
		const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const items = root.querySelectorAll<HTMLElement>('[data-categoria]');
		buttons.forEach((btn) =>
			btn.addEventListener('click', () => {
				const f = btn.dataset.filter;
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				items.forEach((it) => (it.hidden = f !== 'todas' && it.dataset.categoria !== f));
			}),
		);
	});
</script>
