---
/**
 * Marcas autogeneradas desde src/config/marcas.yaml.
 * Las fotos se buscan en src/assets/marcas/; si no hay foto, se muestran las iniciales.
 * Carrusel deslizable (con el dedo, arrastrando con el ratón o con las flechas); al pulsar
 * una marca se muestra su descripción debajo. Los filtros solo se ven en escritorio.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { getMarcas } from '../lib/config';

const { categorias: oficiales, marcas } = await getMarcas();
// Logos y fotos: los de mapa de bits se optimizan con <Image>; los SVG se sirven tal cual
const raster = import.meta.glob<{ default: ImageMetadata }>('../assets/marcas/*.{png,jpg,jpeg,webp,avif}', {
	eager: true,
});
const vectores = import.meta.glob<string>('../assets/marcas/*.svg', { eager: true, query: '?url', import: 'default' });
const fotoDe = (nombre?: string) => {
	if (!nombre) return undefined;
	const key = `../assets/marcas/${nombre.replace(/^marcas\//, '')}`;
	if (raster[key]) return { kind: 'raster' as const, src: raster[key].default };
	if (vectores[key]) return { kind: 'svg' as const, src: vectores[key] };
	throw new Error(`src/config/marcas.yaml: no se encuentra la foto "${nombre}" en src/assets/marcas/`);
};
const iniciales = (n: string) =>
	n
		.split(/[\s-]+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w[0]!.toUpperCase())
		.join('');
// Orden oficial del YAML; solo las categorías que tienen alguna marca
const categorias = oficiales.filter((c) => marcas.some((m) => m.categoria === c));
const slug = (s: string) =>
	s
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-');
---

<div class="marcas reveal" data-marcas>
	{
		categorias.length > 1 && (
			<div class="marcas__filters" role="group" aria-label="Filtrar marcas por categoría">
				<button type="button" class="chip" aria-pressed="true" data-filter="todas">
					Todas
				</button>
				{categorias.map((c) => (
					<button type="button" class="chip" aria-pressed="false" data-filter={slug(c)}>
						{c}
					</button>
				))}
			</div>
		)
	}

	{
		marcas.length === 0 ? (
			<p class="marcas__empty">Pronto podrás ver aquí las marcas que tenemos en la farmacia.</p>
		) : (
			<>
				<div class="marcas__carousel">
					<ul class="marcas__track" role="list" aria-label="Marcas" tabindex="0" data-track>
						{marcas.map((m) => {
							const foto = fotoDe(m.foto);
							return (
								<li class="marca" data-categoria={slug(m.categoria)}>
									<button
										type="button"
										class="marca__btn"
										aria-expanded="false"
										aria-controls="marcas-panel"
										data-marca
										data-nombre={m.nombre}
										data-cat={m.categoria}
									>
										<span class:list={['marca__media', { 'has-logo': foto }]}>
											{foto?.kind === 'raster' ? (
												<Image src={foto.src} alt="" width={320} class="marca__img" draggable="false" />
											) : foto?.kind === 'svg' ? (
												<img src={foto.src} alt="" class="marca__img" loading="lazy" decoding="async" draggable="false" />
											) : (
												<span class="marca__initials" aria-hidden="true">
													{iniciales(m.nombre)}
												</span>
											)}
										</span>
										<span class="marca__name">{m.nombre}</span>
									</button>
									{/* Sin JavaScript la descripción se ve en la ficha; con JavaScript, en el panel */}
									<p class="marca__desc">{m.descripcion}</p>
								</li>
							);
						})}
					</ul>
					<button type="button" class="marcas__arrow marcas__arrow--prev" aria-label="Marcas anteriores" data-prev hidden>
						<Icon name="caret-left" size={22} />
					</button>
					<button type="button" class="marcas__arrow marcas__arrow--next" aria-label="Más marcas" data-next hidden>
						<Icon name="caret-right" size={22} />
					</button>
				</div>
				<div class="marcas__panel" id="marcas-panel" aria-live="polite" data-panel hidden>
					<p class="marcas__panel-cat" data-panel-cat />
					<p class="marcas__panel-name" data-panel-name />
					<p class="marcas__panel-desc" data-panel-desc />
					<button type="button" class="marcas__panel-close" aria-label="Cerrar descripción" data-panel-close>
						<Icon name="x" size={18} />
					</button>
				</div>
			</>
		)
	}
</div>

<style>
	.marcas {
		position: relative;
		display: grid;
		gap: var(--s-200);
		min-width: 0;
	}

	/* Filtros: solo en escritorio y tableta */
	.marcas__filters {
		display: none;
	}

	@media (min-width: 640px) {
		.marcas__filters {
			display: flex;
			flex-wrap: wrap;
			gap: var(--s-75);
		}
	}

	.chip {
		min-height: 44px;
		padding: var(--s-75) var(--s-200);
		border: 0;
		border-radius: 9999px;
		background: var(--card);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: var(--ink);
		font: inherit;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.14);
		transition:
			background-color 0.7s var(--ease),
			color 0.7s var(--ease),
			transform 0.7s var(--ease);
	}

	.chip:hover {
		transform: translateY(-2px);
	}

	.chip:active {
		transform: scale(0.98);
	}

	.chip[aria-pressed='true'] {
		background: var(--ink);
		color: var(--foam);
	}

	/* ── Carrusel ── */
	.marcas__carousel {
		position: relative;
		min-width: 0;
	}

	.marcas__track {
		--visibles: 2.3;
		display: flex;
		gap: var(--s-100);
		margin: 0;
		padding: var(--s-75) 0 var(--s-200);
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.marcas__track::-webkit-scrollbar {
		display: none;
	}

	@media (min-width: 640px) {
		.marcas__track {
			--visibles: 3.4;
			gap: var(--s-200);
		}
	}

	@media (min-width: 1024px) {
		.marcas__track {
			--visibles: 5;
		}
	}

	/* Arrastrando con el ratón */
	.marcas__track.is-dragging {
		scroll-snap-type: none;
		cursor: grabbing;
		user-select: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.marcas__track {
			cursor: grab;
		}
	}

	.marca {
		flex: 0 0 calc((100% - (var(--visibles) - 1) * var(--s-200)) / var(--visibles));
		display: flex;
		flex-direction: column;
		scroll-snap-align: start;
	}

	.marca[hidden] {
		display: none;
	}

	.marca__btn {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		padding: 0;
		overflow: hidden;
		border: 0;
		border-radius: 16px;
		background: var(--card);
		color: var(--ink);
		font: inherit;
		text-align: left;
		cursor: inherit;
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.14);
		transition:
			transform 0.7s var(--ease),
			box-shadow 0.5s var(--ease);
	}

	@media (hover: hover) {
		.marca__btn:hover {
			transform: translateY(-2px);
		}
	}

	.marca__btn[aria-expanded='true'] {
		box-shadow:
			inset 0 0 0 3px var(--sea),
			0 8px 24px rgb(14 58 91 / 0.14);
	}

	.marca__media {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		background: #fff;
	}

	/* Logos: enteros y centrados sobre fondo blanco */
	.marca__media.has-logo {
		padding: var(--s-200);
	}

	.marca__img {
		width: 100%;
		height: 100%;
		max-height: 64px;
		object-fit: contain;
		pointer-events: none;
		-webkit-user-drag: none;
	}

	.marca__initials {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 9999px;
		background: var(--foam);
		color: var(--brand);
		font-size: 1.25rem;
		line-height: 1.75rem;
		font-weight: 700;
		box-shadow: inset 0 0 0 2px var(--brand-soft);
	}

	/* El nombre ocupa el resto de la ficha: si otra marca necesita dos líneas, queda centrado */
	.marca__name {
		flex: 1;
		display: flex;
		align-items: center;
		padding: var(--s-75) var(--s-100);
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 700;
		border-top: 1px solid var(--line);
	}

	.marca__desc {
		padding: var(--s-75) var(--s-100) 0;
		font-size: 0.75rem;
		line-height: 1rem;
		color: var(--ink);
	}

	.is-enhanced .marca__desc {
		display: none;
	}

	/* Flechas: solo en pantallas con ratón o anchas */
	.marcas__arrow {
		position: absolute;
		top: calc(50% - var(--s-100));
		z-index: 1;
		display: none;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 9999px;
		background: var(--foam);
		color: var(--ink);
		cursor: pointer;
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.24);
		transform: translateY(-50%);
		transition:
			opacity 0.5s var(--ease),
			background-color 0.5s var(--ease);
	}

	.marcas__arrow--prev {
		left: calc(-1 * var(--s-200));
	}

	.marcas__arrow--next {
		right: calc(-1 * var(--s-200));
	}

	@media (min-width: 640px) {
		.marcas__arrow:not([hidden]) {
			display: grid;
		}
	}

	.marcas__arrow:hover {
		background: #fff;
	}

	.marcas__arrow:disabled {
		opacity: 0;
		pointer-events: none;
	}

	/* ── Descripción de la marca pulsada ── */
	.marcas__panel {
		position: relative;
		display: grid;
		gap: var(--s-50);
		max-width: 640px;
		padding: var(--s-200) var(--s-600) var(--s-200) var(--s-200);
		border-radius: 16px;
		background: var(--card);
		box-shadow: 0 8px 24px rgb(14 58 91 / 0.14);
		animation: panel-in 0.5s var(--ease);
	}

	.marcas__panel[hidden] {
		display: none;
	}

	.marcas__panel-cat {
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sea);
	}

	.marcas__panel-name {
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 700;
	}

	.marcas__panel-desc {
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--ink-soft);
	}

	.marcas__panel-close {
		position: absolute;
		top: var(--s-50);
		right: var(--s-50);
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 9999px;
		background: none;
		color: var(--ink-soft);
		cursor: pointer;
	}

	.marcas__panel-close:hover {
		background: rgb(14 58 91 / 0.06);
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marcas__panel {
			animation: none;
		}
	}

	.marcas__empty {
		padding: var(--s-400);
		border-radius: 24px;
		background: var(--card);
	}
</style>

<script>
	const slugify = (s: string) =>
		s
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-');

	document.querySelectorAll<HTMLElement>('[data-marcas]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('[data-track]');
		if (!track) return;
		root.classList.add('is-enhanced');
		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
		const items = Array.from(track.querySelectorAll<HTMLElement>('[data-categoria]'));
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const panel = root.querySelector<HTMLElement>('[data-panel]')!;
		const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
		let selected: HTMLButtonElement | null = null;

		// ── Descripción de la marca pulsada ──
		function select(btn: HTMLButtonElement | null) {
			selected?.setAttribute('aria-expanded', 'false');
			selected = btn;
			panel.hidden = !btn;
			if (!btn) return;
			btn.setAttribute('aria-expanded', 'true');
			panel.querySelector('[data-panel-cat]')!.textContent = btn.dataset.cat || '';
			panel.querySelector('[data-panel-name]')!.textContent = btn.dataset.nombre || '';
			panel.querySelector('[data-panel-desc]')!.textContent =
				btn.closest('li')?.querySelector('.marca__desc')?.textContent || '';
		}

		track.querySelectorAll<HTMLButtonElement>('[data-marca]').forEach((btn) =>
			btn.addEventListener('click', () => select(selected === btn ? null : btn)),
		);
		panel.querySelector('[data-panel-close]')?.addEventListener('click', () => {
			const btn = selected;
			select(null);
			btn?.focus();
		});

		// ── Flechas ──
		function updateArrows() {
			const max = track!.scrollWidth - track!.clientWidth;
			prev.hidden = next.hidden = max <= 1;
			prev.disabled = track!.scrollLeft <= 1;
			next.disabled = track!.scrollLeft >= max - 1;
		}
		const page = (dir: number) =>
			track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: reduce() ? 'auto' : 'smooth' });
		prev.addEventListener('click', () => page(-1));
		next.addEventListener('click', () => page(1));
		track.addEventListener('scroll', updateArrows, { passive: true });
		new ResizeObserver(updateArrows).observe(track);

		// ── Arrastrar con el ratón (en táctil el deslizamiento es nativo) ──
		let startX = 0;
		let startLeft = 0;
		let dragging = false;
		let moved = false;
		track.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0) return;
			dragging = true;
			moved = false;
			startX = e.clientX;
			startLeft = track.scrollLeft;
		});
		track.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			if (!moved && Math.abs(dx) > 5) {
				moved = true;
				track.classList.add('is-dragging');
				track.setPointerCapture(e.pointerId);
			}
			if (moved) track.scrollLeft = startLeft - dx;
		});
		const endDrag = () => {
			if (!dragging) return;
			dragging = false;
			// Al quitar is-dragging vuelve el scroll-snap y el carrusel se ajusta a la ficha más cercana
			track.classList.remove('is-dragging');
		};
		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);
		// Un arrastre no debe contar como clic en la marca
		track.addEventListener(
			'click',
			(e) => {
				if (moved) {
					e.preventDefault();
					e.stopPropagation();
					moved = false;
				}
			},
			true,
		);

		// ── Filtros (solo visibles en escritorio) ──
		function setFilter(value: string) {
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === value)));
			items.forEach((it) => (it.hidden = value !== 'todas' && it.dataset.categoria !== value));
			if (selected?.closest('li')?.hidden) select(null);
			track!.scrollTo({ left: 0 });
			updateArrows();
		}
		buttons.forEach((btn) => btn.addEventListener('click', () => setFilter(btn.dataset.filter || 'todas')));

		// Enlaces desde otras secciones (p. ej. la noticia de Kiokids). En escritorio aplican el filtro
		// de su categoría; en móvil no hay filtros. Después llevan el carrusel hasta la marca indicada
		// (o la primera de la categoría) y muestran su descripción.
		document.querySelectorAll<HTMLAnchorElement>('[data-filtro-marca], [data-ir-a-marca]').forEach((a) =>
			a.addEventListener('click', () => {
				const value = slugify(a.dataset.filtroMarca || '');
				const filtersVisible = buttons[0] && getComputedStyle(buttons[0].parentElement!).display !== 'none';
				setFilter(filtersVisible && buttons.some((b) => b.dataset.filter === value) ? value : 'todas');
				const nombre = a.dataset.irAMarca;
				const target = nombre
					? items.find((it) => it.querySelector<HTMLElement>('[data-marca]')?.dataset.nombre === nombre)
					: !filtersVisible && value
						? items.find((it) => it.dataset.categoria === value)
						: undefined;
				if (!target || target.hidden) return;
				track!.scrollTo({ left: target.offsetLeft - track!.offsetLeft, behavior: reduce() ? 'auto' : 'smooth' });
				select(target.querySelector<HTMLButtonElement>('[data-marca]'));
			}),
		);

		updateArrows();
	});
</script>
