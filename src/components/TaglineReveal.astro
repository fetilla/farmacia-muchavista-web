---
/** Frase destacada: cada palabra pasa de tono apagado a color pleno al hacer scroll. */
interface Props {
	text: string;
}
const { text } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
---

<div class="tagline" data-tagline>
	<p class="tagline__text">
		<span class="sr-only">{text}</span>
		<span aria-hidden="true">
			{words.map((w) => <span class="tagline__word">{w} </span>)}
		</span>
	</p>
</div>

<style>
	.tagline {
		padding: var(--s-500) var(--s-400);
		border-radius: 24px;
		background: rgb(14 58 91 / 0.92);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		max-width: 880px;
	}

	@media (max-width: 767px) {
		.tagline {
			padding: var(--s-400) var(--s-300);
		}
	}

	.tagline__text {
		max-width: 760px;
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	@media (min-width: 768px) {
		.tagline__text {
			font-size: 3rem;
			line-height: 1.1;
		}
	}

	.tagline__word {
		color: rgb(251 253 255 / 0.48);
		transition: color 0.7s var(--ease);
	}

	.tagline__word.is-on {
		color: var(--foam);
	}

	@media (prefers-reduced-motion: reduce) {
		.tagline__word {
			color: var(--foam);
			transition: none;
		}
	}
</style>

<script>
	// Un único listener de scroll limitado con requestAnimationFrame
	// Las palabras se activan de una en una, en orden de lectura, según avanza el bloque
	const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-tagline]'));
	const words = blocks.flatMap((b) => Array.from(b.querySelectorAll<HTMLElement>('.tagline__word')));
	let ticking = false;
	function update() {
		const vh = window.innerHeight;
		for (const block of blocks) {
			const list = block.querySelectorAll<HTMLElement>('.tagline__word');
			const rect = block.getBoundingClientRect();
			const p = Math.min(1, Math.max(0, (vh * 0.85 - rect.top) / (vh * 0.45)));
			const on = Math.round(p * list.length);
			list.forEach((w, i) => w.classList.toggle('is-on', i < on));
		}
		ticking = false;
	}
	if (words.length) {
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
	}
</script>
