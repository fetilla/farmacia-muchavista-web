---
/**
 * Contáctanos: última sección del recorrido, sobre el último tramo del vídeo.
 * Textos en src/config/secciones.yaml (contacto) y datos en src/config/contacto.yaml.
 */
import HorarioLocalizacion from './HorarioLocalizacion.astro';
import Icon from './Icon.astro';
import { getContacto, getSecciones, whatsappUrl } from '../lib/config';

const c = await getContacto();
const { contacto: s } = await getSecciones();

const canales = [
	{ icon: 'whatsapp-logo', label: 'WhatsApp', value: c.whatsapp.visible, href: whatsappUrl(c), external: true },
	{ icon: 'phone', label: 'Llamada', value: c.telefono.visible, href: `tel:${c.telefono.numero}` },
	{ icon: 'instagram-logo', label: 'Instagram', value: c.instagram.usuario, href: c.instagram.url, external: true },
	{ icon: 'envelope-simple', label: 'Correo', value: c.email, href: `mailto:${c.email}` },
];
---

<section
	id="contacto"
	class="contacto"
	data-chapter
	data-video-start={s.video?.desde}
	data-video-end={s.video?.hasta}
	aria-labelledby="contacto-titulo"
>
	<div class="container contacto__inner">
		<header class="contacto__head reveal">
			{s.antetitulo && <p class="eyebrow">{s.antetitulo}</p>}
			<h2 id="contacto-titulo" class="title">{s.titulo}</h2>
			{s.subtitulo && <p class="lead">{s.subtitulo}</p>}
		</header>

		<ul class="canales" role="list">
			{
				canales.map((ch, i) => (
					<li class="reveal" style={`transition-delay:${i * 80}ms`}>
						<a class="canal" href={ch.href} {...(ch.external ? { target: '_blank', rel: 'noopener' } : {})}>
							<span class="canal__icon">
								<Icon name={ch.icon} size={24} />
							</span>
							<span class="canal__text">
								<span class="canal__label">{ch.label}</span>
								<span class="canal__value">{ch.value}</span>
							</span>
							<Icon name="arrow-right" size={20} class="canal__arrow" />
						</a>
					</li>
				))
			}
		</ul>

		<HorarioLocalizacion headingLevel="h3" />
	</div>
</section>

<style>
	.contacto {
		position: relative;
		/* Última sección: margen extra al final para ver el último tramo del vídeo
		   (hacia el mostrador) a pantalla completa antes de que aparezca el pie */
		min-height: 220vh;
		padding: 40vh 0 90vh;
	}

	.contacto__inner {
		display: grid;
		gap: var(--s-300);
	}

	.contacto__head {
		display: grid;
		gap: var(--s-200);
		max-width: 560px;
		padding: var(--s-400);
		border-radius: 24px;
		background: var(--card);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 24px 64px rgb(14 58 91 / 0.2);
	}

	@media (max-width: 767px) {
		.contacto__head {
			padding: var(--s-300);
		}
	}

	.canales {
		display: grid;
		gap: var(--s-200);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 640px) {
		.canales {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.canal {
		display: flex;
		align-items: center;
		gap: var(--s-200);
		height: 100%;
		padding: var(--s-300);
		border-radius: 24px;
		background: var(--card);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		text-decoration: none;
		box-shadow: 0 16px 48px rgb(14 58 91 / 0.16);
		transition:
			transform 0.7s var(--ease),
			box-shadow 0.7s var(--ease);
	}

	.canal:hover {
		transform: translateY(-4px);
		box-shadow: 0 24px 64px rgb(14 58 91 / 0.22);
	}

	.canal:active {
		transform: scale(0.98);
	}

	.canal__icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: 16px;
		background: rgb(31 143 141 / 0.12);
		color: var(--sea);
	}

	.canal__text {
		display: grid;
		min-width: 0;
	}

	.canal__label {
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		color: var(--ink-soft);
	}

	.canal__value {
		font-weight: 700;
		overflow-wrap: break-word;
	}

	.canal :global(.canal__arrow) {
		margin-left: auto;
		flex: none;
		color: var(--ink-soft);
	}
</style>
