---
/**
 * Recuadro único con el horario (src/config/horario.yaml) y la localización
 * (src/config/contacto.yaml). Se usa en Inicio (compacto: una columna, solo la
 * temporada vigente) y en Contáctanos (completo).
 */
import Horario from './Horario.astro';
import Icon from './Icon.astro';
import { getContacto } from '../lib/config';

interface Props {
	headingLevel?: 'h2' | 'h3';
	compact?: boolean;
}

const { headingLevel = 'h2', compact = false } = Astro.props;
const H = headingLevel;
const contacto = await getContacto();
---

<div class:list={['info-card', { 'info-card--compact': compact }, 'reveal']}>
	<div class="info-card__part">
		<H class="info-card__title">Horario</H>
		<Horario compact={compact} collapse={compact ? 'always' : 'mobile'} />
	</div>
	<div class="info-card__part info-card__part--location">
		<H class="info-card__title">Localización</H>
		<address class="info-card__address">
			<Icon name="map-pin" size={24} />
			<span>
				{contacto.direccion.calle}<br />
				{contacto.direccion.zona}<br />
				{contacto.direccion.cp}, {contacto.direccion.provincia}
			</span>
		</address>
		<a class:list={['btn btn--light', { 'btn--sm': compact }]} href={contacto.maps_url} target="_blank" rel="noopener">
			<Icon name="navigation-arrow" size={20} />
			Cómo llegar
		</a>
	</div>
</div>

<style>
	.info-card {
		display: grid;
		gap: var(--s-400);
		padding: var(--s-400);
		border-radius: 24px;
		background: var(--card);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 24px 64px rgb(14 58 91 / 0.2);
	}

	@media (min-width: 960px) {
		.info-card {
			grid-template-columns: 1.7fr 1fr;
			gap: var(--s-500);
		}
	}

	@media (max-width: 767px) {
		.info-card {
			padding: var(--s-300);
		}
	}

	@media (max-width: 639px) {
		.info-card {
			gap: var(--s-200);
			padding: var(--s-200);
			border-radius: 16px;
		}
		.info-card__part {
			gap: var(--s-100);
		}
		.info-card__part--location {
			padding-top: var(--s-200);
		}
		.info-card__title {
			font-size: 1.25rem;
			line-height: 1.75rem;
		}
		.info-card__address {
			font-size: 1rem;
			line-height: 1.5rem;
		}
	}

	/* Compacto (Inicio): siempre en una columna, con el horario y la dirección más juntos */
	.info-card--compact {
		grid-template-columns: minmax(0, 1fr);
		gap: var(--s-200);
		padding: var(--s-300);
	}

	.info-card--compact .info-card__part {
		gap: var(--s-100);
	}

	.info-card--compact .info-card__part--location {
		padding: var(--s-200) 0 0;
		border-left: 0;
		border-top: 1px solid var(--line);
	}

	.info-card--compact .info-card__title {
		font-size: 1.25rem;
		line-height: 1.75rem;
	}

	.info-card--compact .info-card__address {
		font-size: 1rem;
		line-height: 1.5rem;
	}

	.info-card__part {
		display: grid;
		align-content: start;
		gap: var(--s-200);
	}

	/* Separador entre horario y localización: debajo en móvil, a la izquierda en escritorio */
	.info-card__part--location {
		padding-top: var(--s-400);
		border-top: 1px solid var(--line);
	}

	@media (min-width: 960px) {
		.info-card__part--location {
			padding-top: 0;
			padding-left: var(--s-500);
			border-top: 0;
			border-left: 1px solid var(--line);
		}
	}

	.info-card__title {
		font-size: 1.5rem;
		line-height: 2rem;
	}

	.info-card__address {
		display: flex;
		gap: var(--s-100);
		font-style: normal;
		font-size: 1.125rem;
		line-height: 1.75rem;
	}

	.info-card__address :global(.icon) {
		flex: none;
		color: var(--sea);
		margin-top: 2px;
	}

	.info-card .btn {
		justify-self: start;
	}
</style>
