---
import HorarioLocalizacion from './HorarioLocalizacion.astro';
import Icon from './Icon.astro';
import { getContacto, getSecciones, whatsappUrl } from '../lib/config';

const contacto = await getContacto();
const { inicio } = await getSecciones();
---

<section
	id="inicio"
	class="hero"
	data-chapter
	data-video-start={inicio.video?.desde}
	data-video-end={inicio.video?.hasta}
	aria-labelledby="inicio-titulo"
>
	{inicio.provisional && <Fragment set:html="<!-- TODO: texto provisional en src/config/secciones.yaml (inicio) -->" />}
	<div class="container hero__inner">
		<div class="hero__top">
			{inicio.antetitulo && <p class="hero__eyebrow">{inicio.antetitulo}</p>}
			<h1 id="inicio-titulo" class="hero__title">{inicio.titulo}</h1>
			{inicio.subtitulo && <p class="hero__sub">{inicio.subtitulo}</p>}
			<div class="hero__actions">
				<a class="btn btn--primary" href={`tel:${contacto.telefono.numero}`}>
					<Icon name="phone" size={20} />
					Llámanos al {contacto.telefono.visible}
				</a>
				<a class="btn btn--whatsapp" href={whatsappUrl(contacto)} target="_blank" rel="noopener">
					<Icon name="whatsapp-logo" size={20} />
					Escríbenos por WhatsApp
				</a>
			</div>
		</div>

		<div class="hero__info">
			<HorarioLocalizacion compact />
		</div>
	</div>

	<p class="hero__scroll" aria-hidden="true">
		<span>Desliza para entrar en la farmacia</span>
		<Icon name="arrow-down" size={18} />
	</p>
</section>

<style>
	/* Inicio ocupa una sola pantalla (horario incluido): todo él es la escena de la
	   fachada y el vídeo no se mueve hasta que se entra en Nosotros */
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 100vh;
		min-height: 100svh;
		padding: calc(var(--header-h) + var(--s-400)) 0 var(--s-800);
	}

	.hero__inner {
		display: grid;
		gap: var(--s-400);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr) 380px;
			gap: var(--s-600);
		}
	}

	.hero__top {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--s-300);
		color: #fff;
	}

	.hero__eyebrow {
		padding: var(--s-50) var(--s-100);
		border-radius: 9999px;
		background: rgb(14 58 91 / 0.45);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
	}

	.hero__title {
		max-width: 680px;
		font-size: 2.25rem;
		line-height: 2.5rem;
		letter-spacing: -0.02em;
		background: linear-gradient(90deg, #ffffff, #d9e7ee);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-shadow: none;
		filter: drop-shadow(0 2px 16px rgb(14 58 91 / 0.45));
	}

	@media (min-width: 768px) {
		.hero__title {
			font-size: 3.75rem;
			line-height: 1;
		}
	}

	.hero__sub {
		max-width: 680px;
		font-size: 1.125rem;
		line-height: 1.75rem;
		color: #fff;
		text-shadow:
			0 1px 2px rgb(14 58 91 / 0.7),
			0 2px 16px rgb(14 58 91 / 0.6);
	}

	@media (min-width: 768px) {
		.hero__sub {
			font-size: 1.25rem;
			line-height: 1.75rem;
		}
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-100);
	}

	@media (max-width: 479px) {
		.hero__actions .btn {
			width: 100%;
		}
	}

	.hero__scroll {
		position: absolute;
		left: 50%;
		bottom: var(--s-400);
		display: flex;
		align-items: center;
		gap: var(--s-75);
		transform: translateX(-50%);
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		color: rgb(255 255 255 / 0.85);
		white-space: nowrap;
		animation: bob 2.4s var(--ease) infinite;
	}

	@keyframes bob {
		50% {
			transform: translate(-50%, 6px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__scroll {
			animation: none;
		}
	}

	/* Pantallas bajas o estrechas: el horario queda debajo y el aviso de deslizar sobra */
	@media (max-width: 1023px), (max-height: 700px) {
		.hero__scroll {
			display: none;
		}
	}

	@media (max-width: 1023px) {
		.hero {
			display: block;
			min-height: 0;
			padding-bottom: var(--s-600);
		}
		.hero__top {
			min-height: calc(100svh - var(--header-h) - var(--s-400) - var(--s-600));
			justify-content: center;
		}
		.hero__info {
			max-width: 560px;
		}
	}

</style>
