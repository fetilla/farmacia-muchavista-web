---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import Hero from '../components/Hero.astro';
import Chapter from '../components/Chapter.astro';
import Cards from '../components/Cards.astro';
import Marcas from '../components/Marcas.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { getSecciones } from '../lib/config';

const s = await getSecciones();
---

<Layout>
	<Header />
	<main id="contenido">
		<ScrollWorld>
			<Hero />

			<Chapter id="servicios" seccion={s.servicios}>
				{s.servicios.tarjetas && <Cards tarjetas={s.servicios.tarjetas} variant="service" />}
			</Chapter>

			<Chapter id="promociones" seccion={s.promociones} align="right">
				{s.promociones.tarjetas && <Cards tarjetas={s.promociones.tarjetas} variant="promo" />}
			</Chapter>

			<Chapter id="nosotros" seccion={s.nosotros}>
				{s.nosotros.lema && <TaglineReveal text={s.nosotros.lema} size="lema" />}
			</Chapter>

			<Chapter id="actualidad" seccion={s.actualidad} align="right">
				{s.actualidad.tarjetas && <Cards tarjetas={s.actualidad.tarjetas} variant="news" />}
			</Chapter>

			<Chapter id="marcas" seccion={s.marcas}>
				<Marcas />
			</Chapter>

			<Contacto />
		</ScrollWorld>
	</main>
	<Footer />
	<WhatsAppFab />
</Layout>

<script>
	import { initReveal } from '../scripts/reveal';
	initReveal();
</script>
